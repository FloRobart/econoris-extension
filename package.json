    "url": "https://github.com/FloRobart/econoris-extension/issues"
  },
  "homepage": "https://github.com/FloRobart/econoris-extension#readme",
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
